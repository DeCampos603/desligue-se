# ============================================================================
# VARIÁVEIS DE AMBIENTE — DESLIGUE-SE
# Configure todas elas em: Vercel > Project > Settings > Environment Variables
# Nunca comite valores reais neste arquivo.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Google Gemini — triagem cognitiva TCC-I (/api/classify)
#    Obtenha em: https://aistudio.google.com/
# ----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# Opcional: lista de modelos em ordem de preferência, separados por vírgula.
# Padrão: gemini-2.5-flash,gemini-2.0-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# ----------------------------------------------------------------------------
# 2. Supabase — banco PostgreSQL, autenticação e RLS
#    Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# ----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave pública (também usada no navegador). Valida o JWT das usuárias no servidor.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ATENÇÃO: chave de administrador, ignora o RLS. Usada apenas pelo webhook e
# pelo portal de cobrança para gravar o plano. NUNCA exponha no front-end.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 3. Stripe — pagamentos
#    Obtenha em: https://dashboard.stripe.com/apikeys
#    IMPORTANTE: a chave secreta (aqui) e a publicável (app/app.js) precisam
#    ser do MESMO modo. Duas de teste, ou duas de produção — nunca misturadas.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...

# Segredo de assinatura do webhook, obtido ao cadastrar o endpoint
# https://SEU-DOMINIO/api/webhook em Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_...

# Opcional, porém recomendado em produção: ids dos Prices criados no painel.
# Se estiverem vazios, o preço é criado dinamicamente a cada checkout
# (R$ 19,90/mês e R$ 144,00/ano, definidos em api/_lib/billing.js).
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ----------------------------------------------------------------------------
# 4. Segurança — origens autorizadas a chamar a API (CORS)
#    Separadas por vírgula. https://desliguese.vercel.app e os previews da
#    Vercel já são aceitos por padrão; acrescente aqui o domínio próprio.
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://desliguese.com.br,https://www.desliguese.com.br
